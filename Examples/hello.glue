/*g

 Glue is a minimalist procedural programming language

g*/


func string GetVersion() {
  return "0.1";
}


func int Main() {

    boolean GlueIsAwesome = true;

    if (GlueIsAwesome == true) {
        shout("Yes!!");
    }

    string Version = GetVersion();
    const double Pi = 3.14159;
    sticky string Awesome = "Glue is awesome!";

    shout(Awesome);
    shout("Compilator version: ", Version);
    shout("PI: ", Pi);

    Awesome = "Glue is fast";
    shout(Awesome);


    string DogName = "Pedro";
    int DogAge = 2;

    shout("Dog ", DogName, " has a 3 years old: ", DogAge == 3);


 // End of the program
 // Return is required to exit the program
    return 0;
}




